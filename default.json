{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended", ":disableDependencyDashboard"],
	"schedule": ["before 6am on monday"],
	"minimumReleaseAge": "3 days",
	"lockFileMaintenance": { "enabled": true, "automerge": true },
	"postUpdateOptions": ["gomodTidy"],
	"packageRules": [
		{
			"description": "Non-major updates land as one weekly PR, merged once CI passes",
			"matchUpdateTypes": ["minor", "patch", "pin", "digest"],
			"groupName": "non-major dependencies",
			"automerge": true
		},
		{
			"description": "Minor updates below 1.0 can break (semver 0.x), so they get their own PR and wait for review",
			"matchUpdateTypes": ["minor"],
			"matchCurrentVersion": "<1.0.0",
			"groupName": "0.x minor dependencies",
			"automerge": false
		},
		{
			"description": "My own packages and workflows ship right away and keep every repo on the same version",
			"matchPackageNames": ["@dragunovartem99/**", "html-diagram", "vue-pgn-viewer", "99.css", "dragunovartem99/pipes"],
			"groupName": "own packages",
			"schedule": ["at any time"],
			"minimumReleaseAge": null,
			"automerge": true
		},
		{
			"description": "Major updates always wait for review, my own packages included",
			"matchUpdateTypes": ["major"],
			"automerge": false
		}
	]
}
